{
  "name": "@steward/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "worker": "tsx src/cli.ts worker"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "9.4.0",
    "@fastify/static": "8.3.0",
    "fastify": "5.12.8",
    "nodemailer": "7.0.13",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
