{
  "name": "steward",
  "version": "0.1.0",
  "private": true,
  "description": "Steward — universal, modular, white-label SaaS administration platform",
  "type": "module",
  "workspaces": [
    "apps/server",
    "apps/admin",
    "apps/example-saas",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @steward/admin && npm run build -w @steward/server",
    "start": "npm run start -w @steward/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migrate": "npm run migrate -w @steward/server",
    "seed": "npm run seed -w @steward/server"
  },
  "engines": {
    "node": ">=22.13"
  }
}
