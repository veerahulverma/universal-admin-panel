# Steward configuration. Copy to .env (never commit real values).
# Every variable is optional in development; production requires the ones marked REQUIRED.

# --- Server -------------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
# Public base URL of the server: links in emails, webhooks, checkout redirects.
APP_URL=https://admin.example.com
# Only when the admin UI is served from a different origin (development: Vite on 5173).
# ADMIN_URL=http://localhost:5173

# --- Database -------------------------------------------------------------------------
# REQUIRED in production: PostgreSQL 14+.
DATABASE_URL=postgres://steward:change-me@localhost:5432/steward
DB_POOL_MAX=10
# Development default (no install needed): pglite://./data/pglite

# --- Encryption (REQUIRED in production) ------------------------------------------------
# Comma-separated "<keyId>:<base64 32-byte key>". Secrets (gateway keys, TOTP seeds,
# plugin credentials) are encrypted with AES-256-GCM. Generate a key with:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
# Rotation: append a new key, set ENCRYPTION_ACTIVE_KEY to its id, then run
#   node apps/server/dist/cli.js rotate-keys      (development: npx tsx apps/server/src/cli.ts rotate-keys)
ENCRYPTION_KEYS=
# ENCRYPTION_ACTIVE_KEY=k1

# --- HTTP / proxies ------------------------------------------------------------------
# Behind a load balancer: "true", a hop count (e.g. 1) or a comma-separated list of proxy CIDRs.
# TRUST_PROXY=1
# Secure cookies (defaults to true in production). Keep true whenever served over HTTPS.
# COOKIE_SECURE=true
FORCE_HTTPS=false

# --- Background jobs ------------------------------------------------------------------
# Run the job worker inside the web process. Set false on web nodes when you run
# dedicated workers with: node apps/server/dist/cli.js worker
WORKER=true
WORKER_CONCURRENCY=5

LOG_LEVEL=info

# --- First run ------------------------------------------------------------------------
# One-time token for creating the first administrator at /setup.
# If unset, a random token is generated and printed in the server log.
# SETUP_TOKEN=

# --- Storage and plugins -----------------------------------------------------------------
DATA_DIR=./data
# STORAGE_DIR=./data/storage
# PLUGINS_DIR=./data/plugins
# Run uploaded plugins in a permission-restricted child process (recommended: true).
PLUGIN_SANDBOX=true
# MARKETPLACE_URL=https://plugins.example.com/index.json
# Ed25519 public key (PEM or base64 DER) used to verify marketplace package signatures.
# MARKETPLACE_PUBLIC_KEY=

# --- Development only -----------------------------------------------------------------
# Allow webhooks and plugin HTTP calls to private networks (never in production).
# ALLOW_PRIVATE_NETWORK=false
